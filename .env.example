# Copy to .env locally. Never commit your actual .env or put credentials in chat.
# Node's built-in --env-file can load this file; cloud environment variables are injected directly.
PORT=3000
HOST=127.0.0.1
# Required when exposing the dashboard beyond localhost. Username is daylight.
# APP_PASSWORD=
# Configure securely in cloud settings; also accepts OPENAI_API_KEY for local use.
# DAYLIGHT_OPENAI_KEY=
# Optional system browser; automatically detects /usr/bin/chromium.
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
